# Private review / local development only. No real secrets belong in Git.
SONORAN_STAGE=scaffold
AWS_REGION=us-east-1
# The static review leaves these unset and never sends request data.
NEXT_PUBLIC_COMMERCE_API_URL=
NEXT_PUBLIC_CUSTOMER_LOGIN_URL=
# Optional LOCAL request service. Set true only in a private development environment.
SONORAN_REQUESTS_ENABLED=false
SONORAN_DB_PATH=
SONORAN_ACCESS_SECRET=
SONORAN_STAFF_TOKEN=
SONORAN_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# The provider adapter accepts test keys and signed TEST events only.
SONORAN_TEST_PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SONORAN_STOREFRONT_ORIGIN=
